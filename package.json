{
  "name": "bare-rpc-test",
  "version": "0.1.0",
  "description": "Cross-language conformance vectors, normative spec and reference peer for bare-rpc",
  "exports": {
    ".": "./index.js",
    "./package": "./package.json"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "files": [
    "index.js",
    "fixtures",
    "WIRE.md"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "generate": "node generate.js",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-rpc-test.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-rpc-test/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-rpc-test#readme",
  "dependencies": {
    "bare-fs": "^4.5.6",
    "bare-path": "^3.0.0"
  },
  "devDependencies": {
    "bare-rpc": "1.3.8",
    "brittle": "^3.19.0",
    "compact-encoding": "^3.0.0",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
